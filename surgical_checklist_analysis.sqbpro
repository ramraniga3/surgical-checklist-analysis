index="11" value="105"/><column index="12" value="128"/><column index="13" value="136"/><column index="14" value="75"/><column index="15" value="86"/><column index="16" value="85"/><column index="17" value="169"/><column index="18" value="142"/><column index="19" value="116"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="staff" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="148"/><column index="2" value="172"/><column index="3" value="161"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="surgeons" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="81"/><column index="2" value="105"/><column index="3" value="128"/><column index="4" value="136"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="units" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="77"/><column index="2" value="72"/><column index="3" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    COUNT(*) AS total_observations,
    SUM(compliant) AS compliant_observations,
    ROUND(100.0 * AVG(compliant), 1) AS compliance_pct
FROM checklist_items;

SELECT
    d.item_name,
    COUNT(*) AS observations,
    SUM(c.compliant) AS compliant_observations,
    ROUND(100.0 * AVG(c.compliant), 1) AS compliance_pct
FROM checklist_items AS c
JOIN item_definitions AS d
    ON c.item_definition_id = d.item_definition_id
GROUP BY d.item_name
ORDER BY compliance_pct;


SELECT
    u.unit_name,
    COUNT(*) AS observations,
    SUM(c.compliant) AS compliant_observations,
    ROUND(100.0 * AVG(c.compliant), 1) AS compliance_pct
FROM checklist_items AS c
JOIN procedures AS p
    ON c.procedure_id = p.procedure_id
JOIN units AS u
    ON p.unit_name = u.unit_name
GROUP BY u.unit_name
ORDER BY compliance_pct;

SELECT 
strftime('%Y-%m' , p.procedure_date) AS procedure_month,
count (*) AS observations,
sum(c.compliant) AS compliant_observations,
ROUND(100.0 * AVG(c.compliant), 1) AS compliance_pct
FROM checklist_items as c
JOIN procedures AS p
ON c.procedure_id = p.procedure_id
GROUP BY procedure_month
ORDER BY compliance_pct;

SELECT
pt.procedure_category,
COUNT(*) AS observations,
    SUM(c.compliant) AS compliant_observations,
    ROUND(100.0 * AVG(c.compliant), 1) AS compliance_pct
FROM checklist_items AS c 
JOIN procedures AS p
ON c.procedure_id = p.procedure_id
JOIN procedure_types AS pt
ON p.procedure_type_id = pt.procedure_type_id
GROUP BY pt.procedure_category
ORDER BY compliance_pct;

SELECT 
pt.risk_level,
COUNT (*) AS observations,
sum (c.compliant) AS complaint_observations,
round ( 100 * avg(c.compliant), 1) AS compliance_pct
FROM checklist_items AS c
JOIN procedures AS p
ON c.procedure_id = p.procedure_id
Join procedure_types as pt
ON p.procedure_type_id = pt.procedure_type_id
GROUP BY pt.risk_level
ORDER By compliance_pct;

SELECT 
u.unit_name,
d.item_name,
COUNT (*) AS observations,
sum (c.compliant) AS compliant_observations,
round ( 100 * avg(c.compliant), 1) AS compliance_pct
FROM checklist_items AS c
JOIN procedures as p
ON c.procedure_id = p.procedure_id
JOIN units as u
ON p.unit_name = u.unit_name
JOIN item_definitions as d
ON c.item_definition_id = d.item_definition_id
group by 
u.unit_name, 
d.item_name
ORDER BY
u.unit_name,
compliance_pct;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
